# Copy to /etc/jev-qwen/jev-qwen.env and chmod 600.
# Keep the API key file separate (also chmod 600); never put tokens in this
# file if it is readable by other services.
JEV_CHECKPOINT=/models/checkpoint
JEV_API_KEYS_FILE=/etc/jev-qwen/keys.json
JEV_TRUSTED_PROXIES=127.0.0.1/32
JEV_LOG_LEVEL=INFO
JEV_RATE_LIMIT_RPS=20
JEV_RATE_LIMIT_BURST=40
JEV_RATE_LIMIT_MAX_CLIENTS=4096
JEV_MAX_CONCURRENCY=1
JEV_MAX_BODY_BYTES=1000000
JEV_METRICS_ENABLED=1
HF_HOME=/var/lib/jev-qwen/hf
