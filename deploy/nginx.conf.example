# Minimal TLS-terminating reverse proxy for the decision API.
#
# The FastAPI service does not terminate TLS in-process. Run it on loopback
# with a bearer token, and terminate TLS here:
#
#   export JEV_API_TOKEN="$(python -c 'import secrets; print(secrets.token_urlsafe(32))')"
#   export JEV_CHECKPOINT=/path/to/checkpoint
#   python -m uvicorn jev_qwen.api:app --host 127.0.0.1 --port 8000
#   nginx -c /path/to/this/file -g 'daemon off;'
#
# Replace the certificate paths and server_name before use. Never enable
# JEV_DEV_MODE on a network-facing instance.

worker_processes 1;

events {
    worker_connections 1024;
}

http {
    server_tokens off;
    client_max_body_size 1m;

    server {
        listen 443 ssl;
        server_name decision.example.internal;

        ssl_certificate     /etc/ssl/certs/decision.example.internal.pem;
        ssl_certificate_key /etc/ssl/private/decision.example.internal.key;
        ssl_protocols       TLSv1.2 TLSv1.3;

        location / {
            proxy_pass http://127.0.0.1:8000;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
            # The Authorization header is forwarded unchanged; the app checks it.
            proxy_read_timeout 300s;
        }
    }

    server {
        listen 80;
        server_name decision.example.internal;
        return 301 https://$host$request_uri;
    }
}
